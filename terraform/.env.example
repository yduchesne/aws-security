export TF_STATE_BUCKET="your-terraform-state-bucket"
export TF_STATE_REGION="your-bootstrap-bucket-region"
export TF_MANAGEMENT_ACCOUNT_ID="your-management-account-id"

# This will be used to create an SSO user in Identity Center
# that you want to use for general administration. This is not an
# IAM user: it is a user that you can associate to groups in Identity Center.
#
# In the context of this project: make it correspond to the email you consider
# representing the administrator for the whole infra. It can be the email you used
# for the root user of your management account.
#
# More precisely:
# - An IAM Identity Center group contains users.
# - An account assignment associates that group with a permission set in a target AWS account.
# - Users in the group can then obtain temporary sessions in that account with the permissions
#   defined by the permission set.

# For example, if your email is 'your-email@example.com', then the following should be set
# to 'your-email'
export TF_MAIN_USER_BASE_NAME="your-base-email-alias"
# For example, if your email is 'your-email@example.com', then the following should be set
# to 'example.com'
export TF_MAIN_USER_EMAIL_DOMAIN="examples.com"

# Combines the two above values (which are also used further below)
export TF_SSO_MAIN_USER_EMAIL="${TF_MAIN_USER_BASE_NAME}+sso@${TF_MAIN_USER_EMAIL_DOMAIN}"
export TF_SSO_MAIN_USER_FIRST_NAME="your-first-name"
export TF_SSO_MAIN_USER_LAST_NAME="your-last-name"

# Main TF variables
export TF_VAR_home_region=$TF_STATE_REGION
export TF_VAR_management_account_id=$TF_MANAGEMENT_ACCOUNT_ID

# SSO admin user
export TF_VAR_sso_admin_user_email="${TF_MAIN_USER_BASE_NAME}+sso_admin@${TF_MAIN_USER_EMAIL_DOMAIN}"
export TF_VAR_sso_admin_user_first_name="${TF_SSO_MAIN_USER_FIRST_NAME}"
export TF_VAR_sso_admin_user_last_name="${TF_SSO_MAIN_USER_LAST_NAME}"

# SSO access management user
export TF_VAR_sso_access_user_email="${TF_MAIN_USER_BASE_NAME}+sso_access@${TF_MAIN_USER_EMAIL_DOMAIN}"
export TF_VAR_sso_access_user_first_name="${TF_SSO_MAIN_USER_FIRST_NAME}"
export TF_VAR_sso_access_user_last_name="${TF_SSO_MAIN_USER_LAST_NAME}"

# Security Tooling and Log Archive account emails
export TF_VAR_security_tooling_account_email="${TF_MAIN_USER_BASE_NAME}+aws_security@${TF_MAIN_USER_EMAIL_DOMAIN}"
export TF_VAR_log_archive_account_email="${TF_MAIN_USER_BASE_NAME}+aws_log_archive@${TF_MAIN_USER_EMAIL_DOMAIN}"

# Budget alert email
export TF_VAR_budget_notification_emails='["${TF_MAIN_USER_BASE_NAME}+aws_bugets@${TF_MAIN_USER_EMAIL_DOMAIN}"]'

# Identity Center administrative personas (three distinct named humans).
export TF_VAR_sso_identity_store_admin_email="${TF_MAIN_USER_BASE_NAME}+sso_store_admin@${TF_MAIN_USER_EMAIL_DOMAIN}"
export TF_VAR_sso_identity_store_admin_first_name="Identity"
export TF_VAR_sso_identity_store_admin_last_name="Administrator"
export TF_VAR_sso_permission_set_admin_email="${TF_MAIN_USER_BASE_NAME}+sso_permissions_admin@${TF_MAIN_USER_EMAIL_DOMAIN}"
export TF_VAR_sso_permission_set_admin_first_name="Permission"
export TF_VAR_sso_permission_set_admin_last_name="Administrator"
export TF_VAR_sso_access_assignment_admin_email="${TF_MAIN_USER_BASE_NAME}+sso_assign_admin@${TF_MAIN_USER_EMAIL_DOMAIN}"
export TF_VAR_sso_access_assignment_admin_first_name="Assignment"
export TF_VAR_sso_access_assignment_admin_last_name="Administrator"

# AWSControlTowerBaseline 5.0 is required by the current landing-zone version.
export TF_VAR_control_tower_baseline_version="5.0"

# Manually operated Identity Center test users. Terraform creates their user
# records but intentionally creates no group memberships or account assignments.
export TF_VAR_test_user1_email="${TF_MAIN_USER_BASE_NAME}+test_user1@${TF_MAIN_USER_EMAIL_DOMAIN}"
export TF_VAR_test_user1_first_name="Test"
export TF_VAR_test_user1_last_name="User One"
export TF_VAR_test_user2_email="${TF_MAIN_USER_BASE_NAME}+test_user2@${TF_MAIN_USER_EMAIL_DOMAIN}"
export TF_VAR_test_user2_first_name="Test"
export TF_VAR_test_user2_last_name="User Two"

# Workload Test and Production operator permission sets are read-only by
# default. Add only reviewed, explicit write actions once workload operational
# requirements are known. Wildcard actions are rejected.
export TF_VAR_test_operator_allowed_actions='[]'
export TF_VAR_production_operator_allowed_actions='[]'

# Workload account assignments remain empty until AFT-created account IDs are
# known. See terraform/identity_center/workload_access/README.md.
export TF_VAR_account_assignments='{}'

# AFT state defaults to TF_STATE_BUCKET and
# TF_STATE_REGION. Set these to use a different shared AFT backend:
# export TF_AFT_STATE_BUCKET="your-aft-state-bucket"
# export TF_AFT_STATE_REGION="your-aft-state-bucket-region"
#
# Root-specific TF_AFT_ORG_UNIT_STATE_*, TF_AFT_ACCOUNT_STATE_*, and
# TF_AFT_PLATFORM_STATE_* variables override both defaults when required.
# TF_IDENTITY_CENTER_AFT_ACCESS_STATE_BUCKET and
# TF_IDENTITY_CENTER_AFT_ACCESS_STATE_REGION can override the AFT access root.
# TF_IDENTITY_CENTER_WORKLOAD_ACCESS_STATE_BUCKET and
# TF_IDENTITY_CENTER_WORKLOAD_ACCESS_STATE_REGION can override the workload access root.
# TF_WORKLOAD_ORG_UNITS_STATE_BUCKET and
# TF_WORKLOAD_ORG_UNITS_STATE_REGION can override the workload OU root.

# AFT account request
# TF_VAR_audit_account_id and TF_VAR_log_archive_account_id are loaded
# automatically from the bootstrap Terraform state before platform deployment.
# See: docs/aft-setup.md.
export TF_VAR_aft_management_account_email="${TF_MAIN_USER_BASE_NAME}+aws_aft@${TF_MAIN_USER_EMAIL_DOMAIN}"
# Account Factory creates/references this human user; the aft_access root looks
# it up and assigns AFTPlatformAdministration without taking ownership of it.
export TF_VAR_sso_aft_user_email="${TF_MAIN_USER_BASE_NAME}+aft_sso@${TF_MAIN_USER_EMAIL_DOMAIN}"
export TF_VAR_sso_aft_user_first_name="${TF_SSO_MAIN_USER_FIRST_NAME}"
export TF_VAR_sso_aft_user_last_name="${TF_SSO_MAIN_USER_LAST_NAME}"

# AFT Git repositories used for account requests and customizations.
# 4 repositories are necessary - e.g.: "yduchesne/aws-security-aft-account-request" and so forth.
# See: docs/aft-setup.md.
export TF_VAR_account_request_repo_name="your-account-request-repo-name"
export TF_VAR_global_customizations_repo_name="your-global-customizations-repo-name"
export TF_VAR_account_customizations_repo_name="your-account-customizations-repo-name"
export TF_VAR_account_provisioning_customizations_repo_name="your-account-provisioning-customizations-repo-name"

# For this architecture: disable the AFT VPC and its NAT gateways/endpoints, to save on costs - see docs/aft-setup.md.
export TF_VAR_aft_enable_vpc=false
