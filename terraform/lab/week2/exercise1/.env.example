# Shell environment template for Week 2 Exercise 1.
# Copy this file to .env, replace every placeholder, and source it before
# running Terraform. Do not store credentials or commit the local .env file.
# IMPORTANT: source the global environment file before sourcing this file.
# See docs/lab/week2/exercise1.md for the complete procedure.

export TF_VAR_source_account_id="your-dev-lab-account-id"
export TF_VAR_target_account_id="your-test-lab-account-id"
export TF_VAR_source_aws_profile="week2-source"
export TF_VAR_target_aws_profile="week2-target"
# See docs/lab/week2/exercise1.md for how to obtain the <SUFFIX>.
export TF_VAR_source_operator_role_arn="arn:aws:iam::$TF_VAR_source_account_id:role/aws-reserved/sso.amazonaws.com/${TF_VAR_home_region:-us-east-2}/AWSReservedSSO_WorkloadLabAdministrator_<SUFFIX>"


# These names must be globally unique and retain the authorized prefix.
export TF_VAR_approved_bucket_name="aws-security-week2-<unique-value>-approved"
export TF_VAR_unrelated_bucket_name="aws-security-week2-<unique-value>-unrelated"
