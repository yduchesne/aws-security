# Copy to .env and source the shared environment first:
# source ~/.env/aws-security/terraform/.env
# Then source this file. Do not commit .env or credentials.
export TF_VAR_source_account_id="${TF_LAB_DEV_ACCOUNT_ID}"
export TF_VAR_target_account_id="${TF_LAB_TEST_ACCOUNT_ID}"
export TF_VAR_source_aws_profile="week2-source"
export TF_VAR_aws_region="${TF_HOME_REGION}"
export TF_VAR_target_aws_profile="week2-target"

# Replace these OIDC values with the issuer, current certificate thumbprint,
# and exact subject claim used by the external workload provider.
export TF_VAR_oidc_url="https://token.actions.githubusercontent.com"
# Well-known thumbprint for Github
export TF_VAR_oidc_thumbprint="6938fd4d98bab03faadb97b34396831e3780aea1"
# Example: repo:yduchesne@1675989/aws-security@1339851610:ref:refs/heads/dev/oidc/main
#   To obtain the @ and @ org and repo suffix, use the following Github CLI
#   command:
#   gh api repos/yduchesne/aws-security \
#     --jq '{repository_id: .id, owner_id: .owner.id, full_name: .full_name}'
# You'll get the IDs in the response:
#   {
#     "full_name": "yduchesne/aws-security",
#     "owner_id": 1675989,
#     "repository_id": 1339851610
#   }
export TF_VAR_oidc_subject="repo:ORG/REPOSITORY:ref:refs/heads/main"
