# Copy to .env and source the shared environment first:
# source ~/.env/aws-security/terraform/.env
# Then source this file. Do not commit .env or credentials.
export TF_VAR_source_account_id="${TF_LAB_DEV_ACCOUNT_ID}"
export TF_VAR_external_account_id="${TF_LAB_TEST_ACCOUNT_ID}"
export TF_VAR_source_aws_profile="week2-source"
export TF_VAR_aws_region="${TF_HOME_REGION}"

# This name must be globally unique and retain the authorized prefix.
# The management account ID provides uniqueness without using credentials.
export TF_VAR_bucket_name="aws-security-week2-${TF_MANAGEMENT_ACCOUNT_ID}-exercise10"

# Set to false, apply, and verify the Access Analyzer finding resolves.
export TF_VAR_external_grant_enabled="true"
