# Copy to .env and source the shared environment first:
# source ~/.env/aws-security/terraform/.env
# Then source this file. Do not commit .env or credentials.
export TF_VAR_source_account_id="${TF_LAB_DEV_ACCOUNT_ID}"
export TF_VAR_target_account_id="${TF_LAB_TEST_ACCOUNT_ID}"
export TF_VAR_source_aws_profile="week2-source"
export TF_VAR_target_aws_profile="week2-target"
export TF_VAR_aws_region="${TF_HOME_REGION}"

# SCP administration runs in the Organizations management account.
export TF_VAR_management_account_id="${TF_MANAGEMENT_ACCOUNT_ID}"
export TF_VAR_management_aws_profile="${TF_STATE_PROFILE}"

# ExternalId is an identifier, not a password.
export TF_VAR_external_id="aws-security-exercise15-$TF_MANAGEMENT_ACCOUNT_ID"

# Keep false for the positive (allow) test; flip to true to attach the SCP
# deny (Failure C), then back to false to prove recovery.
export TF_VAR_scp_deny_enabled="false"
