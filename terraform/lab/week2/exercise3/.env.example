# Copy to .env and source the shared environment first:
# source ~/.env/aws-security/terraform/.env
# Then source this file. Do not commit .env or credentials.
export TF_VAR_source_account_id="${TF_LAB_DEV_ACCOUNT_ID}"
export TF_VAR_target_account_id="${TF_LAB_TEST_ACCOUNT_ID}"
export TF_VAR_source_aws_profile="week2-source"
export TF_VAR_aws_region="${TF_HOME_REGION}"
export TF_VAR_source_profile="week2-source"
# ExternalId is an identifier, not a password; choose a stable unique value.
export TF_VAR_external_id="aws-security-exercise3-$TF_MANAGEMENT_ACCOUNT_ID"
